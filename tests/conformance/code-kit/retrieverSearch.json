{
  "schema": 1,
  "function": "retrieverSearch",
  "cases": [
    {
      "name": "ranked by cosine",
      "args": [
        {
          "schema_version": 1,
          "embedding_model": "m",
          "index_dim": 2,
          "scale": 127,
          "count": 3,
          "granularity": "note",
          "quant": "int8"
        },
        [
          "a",
          "b",
          "c"
        ],
        [
          127,
          0,
          0,
          127,
          90,
          90
        ],
        [
          1,
          0
        ],
        {
          "k": 3,
          "minSim": -1,
          "exclude": []
        }
      ],
      "expected": [
        {
          "path": "a",
          "score": 1
        },
        {
          "path": "c",
          "score": 0.7071068286895752
        },
        {
          "path": "b",
          "score": 0
        }
      ]
    },
