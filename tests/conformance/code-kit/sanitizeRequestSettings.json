        }
      ],
      "expected": {
        "settings": {
          "overrides": {
            "structured": {
              "qwen3.8": {
                "temperature": 0.2,
                "top_k": 40
              }
            }
          },
          "thinking": {
            "structured": "low"
          },
          "lastOnLevel": {
            "creative": "high"
          },
          "levelPickerInChat": true
        },
        "dropped": []
      }
    },
    {
