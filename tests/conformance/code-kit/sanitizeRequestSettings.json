      "args": [
        "nonsense"
      ],
      "expected": {
        "settings": {
          "overrides": {},
          "thinking": {},
          "lastOnLevel": {},
          "levelPickerInChat": false
        },
        "dropped": []
      }
    },
    {
      "name": "array",
      "args": [
        [
          1,
          2
        ]
      ],
      "expected": {
        "settings": {
          "overrides": {},
