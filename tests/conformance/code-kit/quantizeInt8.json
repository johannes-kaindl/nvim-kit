{
  "schema": 1,
  "function": "quantizeInt8",
  "cases": [
    {
      "name": "unit values",
      "args": [
        [
          1,
          -1,
          0
        ],
        127
      ],
      "expected": [
        127,
        -127,
        0
      ]
    },
    {
      "name": "halves round toward +inf",
      "args": [
        [
          0.125,
          -0.125,
          0.625,
          -0.625
        ],
        4
      ],
      "expected": [
        1,
        0,
        3,
        -2
      ]
    },
    {
      "name": "clamped",
      "args": [
        [
          2,
          -2
        ],
        4
      ],
      "expected": [
        4,
        -4
      ]
    },
    {
      "name": "typical unit vector",
      "args": [
        [
          0.6,
          -0.8,
          0,
          0.0001,
          -0.0001
        ],
        127
      ],
      "expected": [
        76,
        -102,
        0,
        0,
        0
      ]
    },
    {
      "name": "float32 values",
      "args": [
        [
          0.1,
          0.2,
          0.3,
          0.7,
          0.9
        ],
        127
      ],
      "expected": [
        13,
        25,
        38,
        89,
        114
      ]
    }
  ]
}
